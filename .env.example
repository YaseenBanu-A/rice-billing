# Copy to .env for local development and fill in the values. Never commit .env.

# PostgreSQL connection. For the local database (`npm run db:local`), choose any username and password:
# the local database is created with them the first time it starts, plus a copy named <name>_test for the tests.
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@127.0.0.1:5433/ajrice

# First administrator (created on first start only). 8+ characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Signs access tokens. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
